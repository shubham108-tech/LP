{
  "name": "library-system-root",
  "version": "1.0.0",
  "scripts": {
    "build": "node build_vercel.js",
    "vercel-build": "node build_vercel.js",
    "start": "node backend/server.js",
    "dev": "node update_hosts.js && concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install-deps": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && node seed.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.2.0",
    "nodemailer": "^8.0.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pdfkit-table": "^0.1.99",
    "pg": "^8.22.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "twilio": "^4.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
